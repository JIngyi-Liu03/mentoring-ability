# ============================================================================
# 导师辅导能力成熟度自评 —— 生产环境配置模板
#
# 用法（在服务器 /opt/mentor-ability 上）：
#   cp .env.production .env
#   然后务必修改下面带【需修改】标记的两项，再启动服务。
#
# 本文件与“职场基因检测”旧站点无关：旧站点用的是 PostgreSQL（docker 卷），
# 本工具用的是独立 SQLite 文件 server/data/mentor.db，互不可见。
# ============================================================================

# 后端服务端口（与旧站点的 8080/8081/3000 区分，避免冲突）
PORT=3001

# 数据库文件位置（相对 server 目录，落盘为 server/data/mentor.db 独立文件）
DB_PATH=./data/mentor.db

# 管理员初始账号（首次启动自动创建；生产环境务必修改密码）【需修改】
ADMIN_USERNAME=admin
ADMIN_PASSWORD=mentoringco2026

# Token 签名密钥（生产环境务必改为随机串）【需修改】
# 生成方式： openssl rand -hex 32
AUTH_SECRET=__CHANGE_ME_auth_secret_generate_with_openssl_rand_hex_32__

# 是否托管前端构建产物（生产必须 true；开发才用 false 走 Vite dev server）
SERVE_DIST=true

# ===== 腾讯云短信（子用户密钥，仅短信权限）=====
# 找回密码 / 注册账号需要发送短信验证码，必须配置以下五项
TENCENT_SECRET_ID=__CHANGE_ME_tencent_secret_id__
TENCENT_SECRET_KEY=__CHANGE_ME_tencent_secret_key__
SMS_SDK_APP_ID=__CHANGE_ME_sms_sdk_app_id__
SMS_SIGN_NAME=__CHANGE_ME_sms_sign_name__
SMS_TEMPLATE_ID=__CHANGE_ME_sms_template_id__
# 验证码有效期（分钟）与同一手机号发送间隔（秒）
SMS_CODE_TTL=5
SMS_SEND_INTERVAL=60
