{
  "name": "mentor-ability001",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "导师辅导能力成熟度自评系统（Vue3 前端 + Express/SQLite 后端 + 管理看板）",
  "scripts": {
    "dev": "concurrently -n SERVER,WEB -c blue,green \"npm --prefix server run dev\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "server": "npm --prefix server run start",
    "install:all": "npm install && npm --prefix server install"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
